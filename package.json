{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.2.23",
  "scripts": {
    "dev": "bun run generate:content && vite",
    "build": "bun run generate:content:prod && bun run generate:github-data && vite build",
    "generate:content": "BLOG_INCLUDE_DRAFTS=true bun run scripts/generate-content.mjs",
    "generate:content:prod": "NODE_ENV=production BLOG_INCLUDE_DRAFTS=false bun run scripts/generate-content.mjs",
    "generate:github-data": "bun run scripts/fetch-github-contributions.mjs",
    "new:post": "bun run scripts/new-post.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/node": "^24.3.0",
    "baseline-browser-mapping": "^2.10.0",
    "caniuse-lite": "^1.0.30001777",
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "three": "^0.183.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "rolldown-vite": "^7.1.13",
    "tailwindcss": "^3.4.17",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.1.2"
  }
}
