#!/bin/sh
# Keeps the compiled shelf fresh: re-ingests before every commit and stages
# public/learnlog if anything changed, so the deployed data can never drift
# from the vault. Deliberately never blocks the commit.
cd "$(dirname "$0")/../.." || exit 0

node scripts/learnlog.mjs >/dev/null 2>&1 || exit 0

if [ -n "$(git status --porcelain -- public/learnlog)" ]; then
  git add -- public/learnlog
  echo "shelf: staged compiled learnlog updates"
fi

exit 0
